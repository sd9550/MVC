@{
    ViewData["Title"] = "Minnesota vs. Wisconsin";
}

<main class="container my-5">
    <header class="text-center mb-4">
        <h1>Minnesota vs. Wisconsin</h1>
        <p class="lead">A quick comparison of two neighboring Midwestern states.</p>
    </header>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Category</th>
                    <th scope="col">Minnesota</th>
                    <th scope="col">Wisconsin</th>
                </tr>
            </thead>
            <tbody>
                <tr><th scope="row">Capital</th><td>Saint Paul</td><td>Madison</td></tr>
                <tr><th scope="row">Largest city</th><td>Minneapolis</td><td>Milwaukee</td></tr>
                <tr><th scope="row">Nickname</th><td>The North Star State</td><td>The Badger State</td></tr>
                <tr><th scope="row">Known for</th><td>Lakes, outdoor recreation, and the Twin Cities</td><td>Dairy farms, Great Lakes shoreline, and local festivals</td></tr>
                <tr><th scope="row">Great Lakes</th><td>Lake Superior</td><td>Lake Michigan and Lake Superior</td></tr>
            </tbody>
        </table>
    </div>

    <div class="row g-4 mt-2">
        <section class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h4 card-title"><a href="/Hello/Minnesota">Minnesota</a></h2>
                    <p class="card-text">Enjoy thousands of lakes, forest trails, and the arts and attractions of Minneapolis–Saint Paul.</p>
                </div>
            </div>
        </section>
        <section class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h4 card-title"><a href="/Hello/Wisconsin">Wisconsin</a></h2>
                    <p class="card-text">Explore charming lakeside towns, scenic countryside, and a celebrated food and sports culture.</p>
                </div>
            </div>
        </section>
    </div>
</main>